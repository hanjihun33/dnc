import groovy.json.JsonOutput

// 어떤 항목이 배포되었는지 기록할 리스트
def deployedList = []

// Mattermost 알림 공통 함수
def sendMM(message) {
    def payload = JsonOutput.toJson([text: message])
    sh "curl -i -X POST -H 'Content-Type: application/json' -d '${payload}' ${env.MM_WEBHOOK_URL}"
}

// 실물 파일 비교 함수 (0이면 같음, 1이면 다름)
def checkDiff(subPath) {
    // -q: 요약, -r: 재귀적 비교
    def status = sh(script: "diff -qr apps/${subPath} ${env.DEPLOY_ROOT_PATH}/apps/${subPath} > /dev/null", returnStatus: true)
    return status != 0
}

pipeline {
    agent any
    
    environment {
        DEPLOY_ROOT_PATH = "/home/ubuntu/dang-nang-kong"
        IMAGE_PREFIX = "jeonggwanwoo/djjko" 
        MM_WEBHOOK_URL = credentials('MM_WEBHOOK')
    }

    stages {
        stage('0. 알림: 변경 감지') {
            steps {
                script {
                    def rawBranch = env.GIT_BRANCH ?: sh(script: "git rev-parse --abbrev-ref HEAD", returnStdout: true).trim()
                    def branchName = rawBranch.replace('origin/', '')
                    def commitMsg = sh(script: "git log -1 --pretty=%B", returnStdout: true).trim()
                    def commitAuthor = sh(script: "git log -1 --pretty=%an", returnStdout: true).trim()

                    def startMessage = """
🛰️ **당낭콩** 인프라 가동 (실물 코드 비교 모드)
- **브랜치**: `${branchName}`
- **작성자**: ${commitAuthor}
- **로그**: ${commitMsg}
                    """.stripIndent().trim()
                    sendMM(startMessage)
                }
            }
        }
        
        stage('1. 소스 체크아웃') {
            steps {
                checkout scm
                // 주의: 여기서 바로 cp(동기화)를 하면 diff 비교가 불가능하므로, 
                // 비교가 끝난 각 배포 스테이지 내부에서 동기화를 진행합니다.
            }
        }

        stage('2. [승인] 백엔드 배포') {
            when {
                expression { return checkDiff("backend") }
            }
            steps {
                script {
                    sendMM("🚧 **[Backend]** 서버 실물 코드와 차이 감지. 배포 승인을 기다리는 중...")
                    input message: "백엔드 배포를 승인하시겠습니까?", ok: "승인"
                    
                    sh """
                        # 소스 동기화 (비교 후 복사)
                        mkdir -p ${env.DEPLOY_ROOT_PATH}/apps/backend
                        cp -ruT apps/backend/ ${env.DEPLOY_ROOT_PATH}/apps/backend/
                        
                        cd ${env.DEPLOY_ROOT_PATH}
                        docker-compose build backend
                        docker tag ${env.IMAGE_PREFIX}-backend:latest ${env.IMAGE_PREFIX}-backend:build-${env.BUILD_NUMBER}
                        docker-compose up -d backend
                    """
                    deployedList.add("Backend")
                }
            }
        }

        stage('3. [승인] AI 서버 배포') {
            when {
                expression { return checkDiff("ai-server") }
            }
            steps {
                script {
                    sendMM("🚧 **[AI Server]** 서버 실물 코드와 차이 감지. 승인 대기 중...")
                    input message: "AI 서버 배포를 승인하시겠습니까?", ok: "승인"
                    
                    sh """
                        # 소스 동기화
                        mkdir -p ${env.DEPLOY_ROOT_PATH}/apps/ai-server
                        cp -ruT apps/ai-server/ ${env.DEPLOY_ROOT_PATH}/apps/ai-server/
                        
                        cd ${env.DEPLOY_ROOT_PATH}
                        docker-compose build ai
                        docker tag ${env.IMAGE_PREFIX}-ai:latest ${env.IMAGE_PREFIX}-ai:build-${env.BUILD_NUMBER}
                        docker-compose up -d ai
                    """
                    deployedList.add("AI Server")
                }
            }
        }

        stage('4. [승인] 프론트엔드 배포') {
            when {
                expression { return checkDiff("mobile") }
            }
            steps {
                script {
                    sendMM("🚧 **[Frontend]** 서버 실물 코드와 차이 감지. 승인 대기 중...")
                    input message: "프론트엔드 배포를 승인하시겠습니까?", ok: "승인"
                    
                    sh """
                        # 소스 동기화
                        mkdir -p ${env.DEPLOY_ROOT_PATH}/apps/mobile
                        cp -ruT apps/mobile/ ${env.DEPLOY_ROOT_PATH}/apps/mobile/
                        
                        cd ${env.DEPLOY_ROOT_PATH}
                        docker-compose build frontend
                        docker tag ${env.IMAGE_PREFIX}-mobile:latest ${env.IMAGE_PREFIX}-mobile:build-${env.BUILD_NUMBER}
                        docker-compose up -d frontend
                    """
                    deployedList.add("Frontend")
                }
            }
        }

        stage('5. Nginx 설정 반영') {
            when { changeset "nginx/**" } // Nginx는 설정 파일 특성상 기존 changeset 유지
            steps {
                script {
                    sh "cd ${env.DEPLOY_ROOT_PATH} && docker-compose exec -T nginx nginx -s reload"
                    deployedList.add("Nginx Config")
                }
            }
        }
    }

    post {
        success { 
            script {
                def summary = deployedList.join(", ") ?: "변경 사항 없음 (서버 상태와 동일)"
                sendMM("🚀 **당낭콩** 배포 완료! (#${env.BUILD_NUMBER})\n- **반영 항목**: ${summary}")
            }
        }
        failure { 
            script {
                def logUrl = "${env.BUILD_URL}console"
                sendMM("🚨 **당낭콩** 배포 실패 (#${env.BUILD_NUMBER})\n- [Jenkins Console Log](${logUrl})")
            }
        }
    }
}