pipeline {
    agent any
    
    environment {
        // [1] 공통 경로 설정
        DEPLOY_ROOT_PATH = "/home/ubuntu/dang-nang-kong"
        
        // [2] 이미지 이름 앞에 붙을 접두사 (도커 허브 ID/프로젝트명)
        // 이 값은 팀장님의 .env 내 이미지 이름과 일치해야 합니다.
        IMAGE_PREFIX = "jeonggwanwoo/djjko" 

        // Jenkins Credentials에 저장된 Mattermost Webhook URL
        MM_WEBHOOK_URL = credentials('MM_WEBHOOK')
    }

    stages {
        stage('0. 알림: develop 변경 감지') {
            steps {
                script {
                    // 1. 젠킨스 변수에서 가져오되, 없으면 git 명령어로 백업 (삼항 연산자 사용)
                    def rawBranch = env.GIT_BRANCH ?: sh(script: "git rev-parse --abbrev-ref HEAD", returnStdout: true).trim()
                    
                    // 2. 'origin/develop'에서 'origin/'을 떼어내고 'develop'만 남기기
                    def branchName = rawBranch.replace('origin/', '')

                    def commitMsg = sh(script: "git log -1 --pretty=%B", returnStdout: true).trim()
                    def commitAuthor = sh(script: "git log -1 --pretty=%an", returnStdout: true).trim()

                    def rawMessage = """
🚀 **당낭콩** 인프라 알림
- **브랜치**: `${branchName}`
- **작성자**: ${commitAuthor}
- **상태**: 변경 감지 (배포 프로세스 시작)
- **최신 커밋**: 
> ${commitMsg}
                    """.stripIndent().trim()

                    def payload = JsonOutput.toJson([text: rawMessage])
                    sh "curl -i -X POST -H 'Content-Type: application/json' -d '${payload}' ${env.MM_WEBHOOK_URL}"
                }
            }
        }
        
        stage('1. 코드 체크아웃 및 전체 동기화') {
            steps {
                checkout scm
                script {
                    echo "🔄 소스 코드 및 설정 파일을 서버로 동기화합니다..."
                    sh """
                        mkdir -p ${env.DEPLOY_ROOT_PATH}
                        # 루트의 설정 파일들 복사
                        cp -u ${WORKSPACE}/*.yml ${env.DEPLOY_ROOT_PATH}/ || true
                        cp -u ${WORKSPACE}/.env ${env.DEPLOY_ROOT_PATH}/ || true
                        
                        # 서비스 소스(apps)와 Nginx 설정(nginx) 폴더 전체 동기화
                        mkdir -p ${env.DEPLOY_ROOT_PATH}/apps
                        cp -ruT apps/ ${env.DEPLOY_ROOT_PATH}/apps/
                        
                        mkdir -p ${env.DEPLOY_ROOT_PATH}/nginx
                        cp -ruT nginx/ ${env.DEPLOY_ROOT_PATH}/nginx/
                    """
                }
            }
        }

        stage('2. [승인] 백엔드 배포') {
            when { changeset "apps/backend/**" }
            steps {
                script {
                    input message: "백엔드 변경이 감지되었습니다. 배포할까요?", ok: "🚀 배포 시작"
                    echo "🐳 백엔드 빌드 및 이력 태깅(build-${env.BUILD_NUMBER})..."
                    sh """
                        cd ${env.DEPLOY_ROOT_PATH}
                        docker-compose build backend
                        # latest 이미지에 빌드 번호 이름표를 하나 더 붙임
                        docker tag ${env.IMAGE_PREFIX}-backend:latest ${env.IMAGE_PREFIX}-backend:build-${env.BUILD_NUMBER}
                        docker-compose up -d backend
                    """
                }
            }
        }

        stage('3. [승인] AI 서버 배포') {
            when { changeset "apps/ai/**" }
            steps {
                script {
                    input message: "AI 서버 변경이 감지되었습니다. 배포할까요?", ok: "🚀 배포 시작"
                    echo "🐳 AI 서버 빌드 및 이력 태깅(build-${env.BUILD_NUMBER})..."
                    sh """
                        cd ${env.DEPLOY_ROOT_PATH}
                        docker-compose build ai
                        docker tag ${env.IMAGE_PREFIX}-ai:latest ${env.IMAGE_PREFIX}-ai:build-${env.BUILD_NUMBER}
                        docker-compose up -d ai
                    """
                }
            }
        }

        stage('4. [승인] 프론트엔드 배포') {
            when { changeset "apps/frontend/**" }
            steps {
                script {
                    input message: "프론트엔드 변경이 감지되었습니다. 배포할까요?", ok: "🚀 배포 시작"
                    echo "🐳 프론트엔드 빌드 및 이력 태깅(build-${env.BUILD_NUMBER})..."
                    sh """
                        cd ${env.DEPLOY_ROOT_PATH}
                        docker-compose build frontend
                        docker tag ${env.IMAGE_PREFIX}-frontend:latest ${env.IMAGE_PREFIX}-frontend:build-${env.BUILD_NUMBER}
                        docker-compose up -d frontend
                    """
                }
            }
        }

        stage('5. [승인] Nginx 설정 반영') {
            // nginx 폴더 내 파일(conf.d 등)이 바뀌었을 때만 실행
            when { changeset "nginx/**" }
            steps {
                script {
                    echo "🔒 Nginx 설정을 새로고침합니다..."
                    // 컨테이너 재시작 없이 설정만 반영 (Zero Downtime)
                    sh "cd ${env.DEPLOY_ROOT_PATH} && docker-compose exec -T nginx nginx -s reload"
                }
            }
        }
    }

    post {
        success { 
            echo "✅ '두쫀코' #${env.BUILD_NUMBER} 빌드 및 배포 성공!" 
        }
        failure { 
            echo "❌ 배포 실패. 젠킨스 로그를 확인해 주세요." 
        }
    }
}